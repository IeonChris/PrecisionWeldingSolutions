# Public site URL, no trailing slash. Drives canonicals, sitemap, robots, JSON-LD and the OG image.
# On Vercel it can be left unset until the domain is live (the Vercel production URL is used).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Quote form email (Resend) -------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Where quote requests are delivered (comma-separate several addresses).
QUOTE_TO=owner@example.com
# Sender. Must be on a domain verified in Resend. Leave unset to use Resend's sandbox sender,
# which can only deliver to the email address that owns the Resend account.
EMAIL_FROM="Precision Welding Solutions <quotes@example.com>"

# --- Instagram feed (#work) ----------------------------------------------------------------
# Option A (recommended, no upkeep): a Behold JSON feed URL, e.g. https://feeds.behold.so/abc123
INSTAGRAM_FEED_URL=
# Option B: long-lived Instagram API token (Instagram Login, Business or Creator account).
# Expires 60 days after issue or last refresh. Rotate with `npm run instagram:refresh`.
INSTAGRAM_ACCESS_TOKEN=
# With neither set, the six captions in src/content.ts are shown.

# --- SEO ping ------------------------------------------------------------------------------
# Protects GET /api/seo/ping. Any long random string.
PING_SECRET=change-me
